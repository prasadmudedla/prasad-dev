# Copy this file to .env and fill in the values. Never commit .env.
# The same three values go into Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys (needs "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (your inbox)
CONTACT_TO=you@example.com

# Sender shown on the email. Must use a domain you've verified in Resend.
# Until prasad.dev is verified, Resend's test sender works: onboarding@resend.dev
CONTACT_FROM="prasad.dev <hello@prasad.dev>"
