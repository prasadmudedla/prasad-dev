---
/* Home: who I am, the test-run terminal, a few featured projects, and a way to get in touch. */
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import StoryCard from '../components/StoryCard.astro';
import { home, contact } from '../data/profile';
import { getStories, slugOf, countWord } from '../lib/work';

const stories = await getStories();
const featured = home.featured
  .map((slug) => stories.find((s) => slugOf(s) === slug))
  .filter((s) => s !== undefined);
---
<Page>
  <Hero />

  <section aria-labelledby="featured-title">
    <div class="sec-head">
      <div><div class="label">Selected work</div><h2 id="featured-title">{home.featuredTitle}</h2></div>
      <a class="see-all" href="/work">All {countWord(stories.length).toLowerCase()} projects →</a>
    </div>
    <div class="tiles">
      {featured.map((entry) => <StoryCard entry={entry} as="h3" />)}
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <h2 id="band-title">{contact.headline}</h2>
    <a class="btn" href="/contact">Say hello</a>
  </section>
</Page>
