---
import { career } from '../data/profile';
interface Props { as?: 'h1' | 'h2' }
const { as: Heading = 'h2' } = Astro.props;
---
<section id="career" aria-labelledby="career-title">
  <div class="sec-head">
    <div><div class="label">Career</div><Heading id="career-title">{career.title}</Heading></div>
    <p>{career.intro}</p>
  </div>
  <div class="chapters">
    {career.chapters.map((c) => (
      <div class:list={['chapter', { now: c.current }]}>
        <span class="yrs">{c.years}</span>
        <div>
          <h3><span class="tick" aria-hidden="true">{c.current ? '◌' : '✓'}</span>{c.company}</h3>
          <div class="role">{c.role}</div>
        </div>
        <p>{c.text}</p>
      </div>
    ))}
  </div>
</section>
