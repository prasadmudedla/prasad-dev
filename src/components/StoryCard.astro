---
/* A short project card that links to the full story page. Used on Home and Work. */
import { storyUrl, type Story } from '../lib/work';
import CaseBar from './CaseBar.astro';

interface Props {
  entry: Story;
  /** Heading level, so each page keeps a tidy outline. */
  as?: 'h2' | 'h3';
}
const { entry, as: Heading = 'h3' } = Astro.props;
const d = entry.data;
---
<article
  class:list={['story', 'tile', { lead: d.lead, current: d.status === 'running' }]}
  data-filters={d.filters.join(' ')}
>
  <CaseBar entry={entry} />
  <div class="tile-in">
    <Heading class="tile-h"><a href={storyUrl(entry)}>{d.headline}</a></Heading>
    <p class="ctx">{d.context}</p>
    <ul class="stack" aria-label="Tools">
      {d.stack.map((t) => <li>{t}</li>)}
    </ul>
    <span class="go" aria-hidden="true">What I built →</span>
  </div>
</article>
