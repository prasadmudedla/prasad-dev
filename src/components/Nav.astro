---
import { nav } from '../data/profile';
---
<nav class="top" aria-label="Main">
  <a class="brand" href="/">prasad<b>.dev</b></a>
  <div class="navr">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <div class="theme" role="group" aria-label="Colour mode">
      <button type="button" data-theme-btn="light" aria-pressed="false">Light</button>
      <button type="button" data-theme-btn="dark" aria-pressed="true">Dark</button>
    </div>
  </div>
</nav>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]')];

  function show(theme: string) {
    document.documentElement.dataset.theme = theme;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeBtn === theme)));
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const theme = b.dataset.themeBtn!;
      show(theme);
      try { localStorage.setItem('prasad-theme', theme); } catch {}
    }),
  );

  show(document.documentElement.dataset.theme ?? 'dark');
</script>
