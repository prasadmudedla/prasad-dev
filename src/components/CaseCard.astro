---
/* The full project card, shown on each story page. Content comes from a file in src/content/work/. */
import { render } from 'astro:content';
import type { Story } from '../lib/work';
import CaseBar from './CaseBar.astro';

interface Props { entry: Story }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<article class:list={['story', 'lead', { current: d.status === 'running' }]} aria-labelledby="story-title">
  <CaseBar entry={entry} />
  <div class="case-in">
    <div class="case-head">
      <h1 id="story-title">{d.headline}</h1>
      <p class="ctx">{d.context}</p>
      <ul class="stack" aria-label="Tools">
        {d.stack.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="built">
      <h2 class="label">What I built</h2>
      <Content />
    </div>
  </div>
</article>
